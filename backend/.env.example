# ---------------------------------------------------------------- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional second channel (group). Leave blank if unused.
TELEGRAM_CHAT_ID_GROUP=

# ---------------------------------------------------------------- storage
# On Railway this MUST point at the mounted volume, otherwise every redeploy wipes the database.
DB_PATH=/data/football.db

# ---------------------------------------------------------------- schedule (HK time)
TZ=Asia/Hong_Kong
SYNC_FIXTURES_HOUR=6
SYNC_ODDS_HOURS=9,12,18,21
SCAN_OFFSETS_MIN=60,30
HEARTBEAT_HOUR=8
WEEKLY_REPORT_DOW=0
WEEKLY_REPORT_HOUR=9

# ---------------------------------------------------------------- model
LEAGUE_BASE_GOALS=1.35
# multipliers on the neutral base rate (measured automatically once you have 20+ matches)
HOME_FACTOR=1.12
AWAY_FACTOR=0.94
FORM_WINDOW=10
SHRINK_MATCHES=6
DIXON_COLES_RHO=-0.05

# ---------------------------------------------------------------- value & staking
EV_THRESHOLD=0.05
MIN_ODDS=1.35
MAX_ODDS=12
UNITS_PER_BET_PCT=1.0
STAKING_MODE=flat
KELLY_FRACTION=0.5
BANKROLL=10000
MAX_BETS_PER_DAY=8
MAX_DAILY_LOSS_PCT=5
MARKETS=HAD,TTG

# automatic paper trading: the system books every value bet itself so a real
# track record accumulates. Set to false if you only want alerts.
AUTO_FOLLOW=true

# ---------------------------------------------------------------- scraper
HTTP_TIMEOUT=20
HTTP_SLEEP=1.2
HTTP_RETRIES=3
ODDS_MOVE_ALERT=0.10

# ---------------------------------------------------------------- optional third-party data (not required)
API_FOOTBALL_KEY=
