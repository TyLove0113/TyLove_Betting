# 用法：複製本檔成 .env，放喺 backend\ 或者 repo 根目錄都可以（程式兩個位都會搵，backend\ 優先）。
# 唔需要為咗怕上 GitHub 而搬走佢：.gitignore 已經擋咗 .env 同 .env.*，只有本範本會上 GitHub。
# Railway 部署時建議唔用 .env，直接填 Railway Variables（環境變數優先於 .env）。
# 檢查有冇讀到：py cli.py env

# ---------------------------------------------------------------- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional second channel (group). Leave blank if unused.
TELEGRAM_CHAT_ID_GROUP=

# ---------------------------------------------------------------- storage
# ★ 下面呢行係 Railway 專用（掛載卷）。本機（Windows / Mac）千萬唔好開佢：
#   一開，程式就會想寫入 /data，Windows 會即刻出
#   FileNotFoundError: [WinError 2] 系統找不到指定的檔案。: '/data'
#   本機想用預設位置就留空／註釋（= repo 內嘅 data\football.db）；
#   想指定位置就寫 DB_PATH=D:\你的路徑\football.db
# Railway 部署：唔喺呢個檔設，去 Railway → Variables 加 DB_PATH=/data/football.db
#DB_PATH=/data/football.db

# ---------------------------------------------------------------- schedule (HK time)
TZ=Asia/Hong_Kong
SYNC_FIXTURES_HOUR=6
SYNC_ODDS_HOURS=9,12,18,21
SCAN_OFFSETS_MIN=60,30
HEARTBEAT_HOUR=8
WEEKLY_REPORT_DOW=0
WEEKLY_REPORT_HOUR=9

# ---------------------------------------------------------------- model
LEAGUE_BASE_GOALS=1.35
# multipliers on the neutral base rate (measured automatically once you have 20+ matches)
HOME_FACTOR=1.12
AWAY_FACTOR=0.94
FORM_WINDOW=10
SHRINK_MATCHES=6
DIXON_COLES_RHO=-0.05

# ---------------------------------------------------------------- value & staking
EV_THRESHOLD=0.05
MIN_ODDS=1.35
MAX_ODDS=12
UNITS_PER_BET_PCT=1.0
STAKING_MODE=flat
KELLY_FRACTION=0.5
BANKROLL=10000
MAX_BETS_PER_DAY=8
MAX_DAILY_LOSS_PCT=5
MARKETS=HAD,TTG

# automatic paper trading: the system books every value bet itself so a real
# track record accumulates. Set to false if you only want alerts.
AUTO_FOLLOW=true

# ---------------------------------------------------------------- scraper
HTTP_TIMEOUT=20
HTTP_SLEEP=1.2
HTTP_RETRIES=3
ODDS_MOVE_ALERT=0.10

# ---------------------------------------------------------------- optional third-party data (not required)
API_FOOTBALL_KEY=
